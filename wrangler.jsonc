{
  "name": "ptaki",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {}
}
